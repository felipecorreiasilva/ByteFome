# Porta em que o servidor Express vai rodar
PORT=3333

# String de conexão com o PostgreSQL (substitua com suas credenciais locais)
# Formato: postgresql://usuario:senha@localhost:5432/nome_do_banco
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_do_banco"

# Chave secreta para assinar os tokens JWT (pode ser qualquer texto longo e seguro)
JWT_SECRET="sua_chave_secreta_super_segura_aqui_123456"

# ==========================================
# CONFIGURAÇÕES DA API EFI BANK (PIX)
# ==========================================

# Define o ambiente: 'sandbox' para Homologação (testes) ou 'production' para Produção
EFI_ENVIRONMENT="sandbox"

# Chaves de Produção (copiadas do painel da Efí)
EFI_CLIENT_ID_PROD=""
EFI_CLIENT_SECRET_PROD=""
EFI_CERT_PROD_PATH="./certs/producao.p12"

# Chaves de Homologação (copiadas do painel da Efí)
EFI_CLIENT_ID_DEV=""
EFI_CLIENT_SECRET_DEV=""
EFI_CERT_DEV_PATH="./certs/homologacao.p12"

# Chave Pix cadastrada na sua conta Efí para receber os pagamentos (ex: CPF, CNPJ, e-mail ou chave aleatória)
EFI_PIX_KEY="a_tua_chave_pix_aqui"